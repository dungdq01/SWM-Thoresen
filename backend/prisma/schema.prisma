model MdImportBatch {
  id              String            @id @default(uuid()) @db.Uuid
  batchNo         String            @unique @map("batch_no") @db.VarChar(50)
  entityName      String            @map("entity_name") @db.VarChar(50)
  templateVersion String            @map("template_version") @db.VarChar(20)
  fileName        String            @map("file_name") @db.VarChar(255)
  fileStorageKey  String?           @map("file_storage_key") @db.VarChar(255)
  importMode      String            @map("import_mode") @db.VarChar(20)
  allOrNothing    Boolean           @default(false) @map("all_or_nothing")
  status          ImportBatchStatus
  totalRows       Int               @default(0) @map("total_rows")
  successRows     Int               @default(0) @map("success_rows")
  failedRows      Int               @default(0) @map("failed_rows")
  skippedRows     Int               @default(0) @map("skipped_rows")
  startedAt       DateTime?         @map("started_at")
  completedAt     DateTime?         @map("completed_at")
  requestedBy     String?           @map("requested_by") @db.Uuid
  correlationId   String?           @map("correlation_id") @db.VarChar(100)
  externalId      String?           @map("external_id") @db.VarChar(120)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  lines           MdImportBatchLine[]
  errors          MdImportError[]

  @@index([entityName, status])
  @@index([requestedBy, createdAt])
  @@map("md_import_batch")
}

model MdImportBatchLine {
  id                String                  @id @default(uuid()) @db.Uuid
  batchId           String                  @map("batch_id") @db.Uuid
  rowNo             Int                     @map("row_no")
  rowPayload        Json                    @map("row_payload")
  actionType        ImportActionType?       @map("action_type")
  processingStatus  ImportProcessingStatus  @map("processing_status")
  targetEntityId    String?                 @map("target_entity_id") @db.Uuid
  targetBusinessKey String?                 @map("target_business_key") @db.VarChar(100)
  validationSummary Json?                   @map("validation_summary")
  committedAt       DateTime?               @map("committed_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  batch             MdImportBatch           @relation(fields: [batchId], references: [id])
  errors            MdImportError[]

  @@unique([batchId, rowNo])
  @@map("md_import_batch_line")
}

model MdImportError {
  id           String           @id @default(uuid()) @db.Uuid
  batchId      String           @map("batch_id") @db.Uuid
  batchLineId  String?          @map("batch_line_id") @db.Uuid
  rowNo        Int?             @map("row_no")
  fieldName    String?          @map("field_name") @db.VarChar(100)
  errorCode    String           @map("error_code") @db.VarChar(50)
  errorMessage String           @map("error_message") @db.Text
  errorLevel   ImportErrorLevel @map("error_level")
  details      Json?
  createdAt    DateTime         @default(now()) @map("created_at")

  batch        MdImportBatch      @relation(fields: [batchId], references: [id])
  batchLine    MdImportBatchLine? @relation(fields: [batchLineId], references: [id])

  @@index([batchId, rowNo])
  @@map("md_import_error")
}
