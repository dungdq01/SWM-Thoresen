model RptReconciliationRun {
  id                   String                       @id @default(uuid()) @db.Uuid
  runId                String                       @unique @map("run_id") @db.VarChar(36)
  triggerType          RptReconciliationTriggerType @map("trigger_type")
  requestedBy          String?                      @map("requested_by") @db.Uuid
  checkIds             Json                         @map("check_ids")
  runScope             Json                         @map("run_scope")
  runStatus            RptReconciliationRunStatus   @map("run_status")
