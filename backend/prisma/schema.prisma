  isFreeDay           Boolean  @map("is_free_day")
  appliedRatePerMtDay Decimal? @map("applied_rate_per_mt_day") @db.Decimal(18, 2)
  dailyAmountVnd      Decimal? @map("daily_amount_vnd") @db.Decimal(18, 2)
  traceJson           Json?    @map("trace_json")
  createdAt           DateTime @default(now()) @map("created_at")
  debitNoteLineId     String?  @map("debit_note_line_id") @db.Uuid

  snapshotRun   BilSnapshotRun    @relation(fields: [snapshotRunId], references: [id])
