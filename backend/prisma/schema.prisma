  uom                 String           @db.VarChar(20)
  inventoryStatusFrom String?          @map("inventory_status_from") @db.VarChar(30)
  inventoryStatusTo   String?          @map("inventory_status_to") @db.VarChar(30)
  scannedLocationCode String?          @map("scanned_location_code") @db.VarChar(50)
  scannedLocationId   String?          @map("scanned_location_id") @db.Uuid
  reasonCode          String?          @map("reason_code") @db.VarChar(50)
  evidenceText        String?          @map("evidence_text") @db.Text
  startedAt           DateTime?        @map("started_at")
  completedAt         DateTime?        @map("completed_at")
  completedBy         String?          @map("completed_by") @db.Uuid
  postingStatus       WePostingStatus  @default(PENDING) @map("posting_status")
  postingRefType      String?          @map("posting_ref_type") @db.VarChar(30)
  postingRefId        String?          @map("posting_ref_id") @db.VarChar(50)
  postingErrorCode    String?          @map("posting_error_code") @db.VarChar(50)
  postingErrorMessage String?          @map("posting_error_message") @db.Text
  externalId          String?          @unique @map("external_id") @db.VarChar(120)
  versionNo           BigInt           @default(0) @map("version_no")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  header       WeWorkHeader          @relation(fields: [workHeaderId], references: [id])
  postingLink  WeWorkPostingLink?
  statusHistory WeWorkStatusHistory[]
  eventLogs    WeWorkEventLog[]
  exceptions   WeWorkException[]

  @@unique([workHeaderId, lineNum])
  @@index([workHeaderId, status, lineNum])
  @@index([scannedLocationId])
