model BilContract {
  id                   String            @id @default(uuid()) @db.Uuid
  contractNumber       String            @unique @map("contract_number") @db.VarChar(30)
  ownerId              String            @map("owner_id") @db.Uuid
  contractScope        String            @default("OWNER") @map("contract_scope") @db.VarChar(20)
  effectiveFrom        DateTime          @map("effective_from") @db.Date
  effectiveTo          DateTime          @map("effective_to") @db.Date
  currencyCode         String            @default("VND") @map("currency_code") @db.VarChar(10)
  isDefault            Boolean           @default(false) @map("is_default")
  status               BilContractStatus @default(DRAFT)
  notes                String?           @db.Text
  versionNo            Int               @default(1) @map("version_no")
  supersededContractId String?           @map("superseded_contract_id") @db.Uuid
  externalId           String            @unique @map("external_id") @db.VarChar(100)
  createdBy            String            @map("created_by") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedBy            String            @map("updated_by") @db.Uuid
  updatedAt            DateTime          @updatedAt @map("updated_at")

  owner       MdOwner                @relation(fields: [ownerId], references: [id])
  superseded  BilContract?           @relation("ContractSupersede", fields: [supersededContractId], references: [id])
  successors  BilContract[]          @relation("ContractSupersede")
  feeLines    BilContractFeeLine[]
  debitNotes  BilDebitNote[]

  @@index([ownerId, effectiveFrom, effectiveTo, status])
  @@map("bil_contract")
}

model BilContractFeeLine {
  id                String     @id @default(uuid()) @db.Uuid
  contractId        String     @map("contract_id") @db.Uuid
  feeType           BilFeeType @map("fee_type")
  cargoForm         CargoForm?  @map("cargo_form")
  warehouseId       String?    @map("warehouse_id") @db.Uuid
  dayTypeScope      String?    @map("day_type_scope") @db.VarChar(20)
  billingUom        String     @default("MT") @map("billing_uom") @db.VarChar(10)
  unitRate          Decimal    @map("unit_rate") @db.Decimal(18, 2)
  minimumCharge     Decimal?   @map("minimum_charge") @db.Decimal(18, 2)
  freeDays          Int?       @map("free_days")
  materialRatePerBag Decimal?  @map("material_rate_per_bag") @db.Decimal(18, 2)
  tierRuleCode      String?    @map("tier_rule_code") @db.VarChar(30)
  priorityRank      Int        @default(100) @map("priority_rank")
