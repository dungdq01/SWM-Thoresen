model ReceiptHeader {
  id                    String        @id @default(uuid()) @db.Uuid
  receiptNumber         String?       @unique @map("receipt_number") @db.VarChar(40)
  receiptType           ReceiptType   @map("receipt_type")
  poId                  String        @map("po_id") @db.VarChar(50)
  asnId                 String?       @map("asn_id") @db.VarChar(50)
  ownerId               String        @map("owner_id") @db.Uuid
  vendorId              String        @map("vendor_id") @db.Uuid
  warehouseId           String        @map("warehouse_id") @db.Uuid
  receivingLocationId   String        @map("receiving_location_id") @db.Uuid
  vehicleNumber         String        @map("vehicle_number") @db.VarChar(30)
  blNumber              String?       @map("bl_number") @db.VarChar(50)
  expectedQty           Decimal       @map("expected_qty") @db.Decimal(18, 3)
  grossWeightKg         Decimal?      @map("gross_weight_kg") @db.Decimal(18, 3)
  tareWeightKg          Decimal?      @map("tare_weight_kg") @db.Decimal(18, 3)
  netWeightKg           Decimal?      @map("net_weight_kg") @db.Decimal(18, 3)
  status                ReceiptStatus @default(DRAFT)
  attemptNumber         Int           @default(1) @map("attempt_number")
  tolerancePctApplied   Decimal?      @map("tolerance_pct_applied") @db.Decimal(8, 4)
  variancePct           Decimal?      @map("variance_pct") @db.Decimal(8, 4)
  isManualEntry         Boolean       @default(false) @map("is_manual_entry")
  manualEntryReasonCode String?       @map("manual_entry_reason_code") @db.VarChar(50)
  postedTransId         String?       @map("posted_trans_id") @db.VarChar(40)
  putawayWorkId         String?       @map("putaway_work_id") @db.VarChar(50)
  cancelReasonCode      String?       @map("cancel_reason_code") @db.VarChar(50)
  cancelledBy           String?       @map("cancelled_by") @db.Uuid
  cancelledAt           DateTime?     @map("cancelled_at")
  externalId            String        @unique @map("external_id") @db.VarChar(120)
  correlationId         String        @map("correlation_id") @db.VarChar(120)
  sourceApp             SourceApp     @map("source_app")
  rowVersion            BigInt        @default(0) @map("row_version")
  createdAt             DateTime      @default(now()) @map("created_at")
  createdBy             String?       @map("created_by") @db.Uuid
  updatedAt             DateTime      @updatedAt @map("updated_at")
  updatedBy             String?       @map("updated_by") @db.Uuid

  owner             MdOwner     @relation(fields: [ownerId], references: [id])
  vendor            MdVendor    @relation(fields: [vendorId], references: [id])
  warehouse         MdWarehouse @relation(fields: [warehouseId], references: [id])
  receivingLocation MdLocation  @relation(fields: [receivingLocationId], references: [id])

  lines             ReceiptLine[]
  weighingLogs      ReceiptWeighingLog[]
  statusHistory     ReceiptStatusHistory[]
  exceptionLogs     ReceiptExceptionLog[]
  integrationStates ReceiptIntegrationState[]

  @@index([vehicleNumber, status, createdAt(sort: Desc)])
  @@index([blNumber, status, createdAt(sort: Desc)])
  @@index([ownerId, warehouseId, status, createdAt(sort: Desc)])
  @@index([poId, asnId])
  @@index([status, createdAt(sort: Desc)])
  @@index([correlationId])
  @@map("receipt_header")
}

model ReceiptLine {
  id                  String            @id @default(uuid()) @db.Uuid
  receiptHeaderId     String            @map("receipt_header_id") @db.Uuid
  lineNumber          Int               @map("line_number")
  itemId              String            @map("item_id") @db.Uuid
  uomId               String            @map("uom_id") @db.Uuid
  expectedQty         Decimal           @map("expected_qty") @db.Decimal(18, 3)
  receivedQty         Decimal?          @map("received_qty") @db.Decimal(18, 3)
