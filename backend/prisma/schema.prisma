// ========== Module 3: Inventory Core Engine Enums ==========

enum InventoryTransType {
  RECEIPT_IN
  SHIPMENT_OUT
  MOVE
  STATUS_CHANGE
  ADJUSTMENT
  COUNT_GAIN
  COUNT_LOSS
  VAS_CONSUME
  VAS_PRODUCE
  TRANSFER_OUT
  TRANSFER_IN
}

enum InventoryStage {
  PHYSICAL
  EXPECTED
  ORDERED
}

enum HoldStatus {
  ACTIVE
  PARTIALLY_RELEASED
  RELEASED
  CONSUMED
  CANCELLED
}

enum ReconciliationRunType {
  SCHEDULED
  ON_DEMAND
  SYSTEM
}

enum ReconciliationScopeType {
  FULL
  WAREHOUSE
  OWNER
  ITEM
}

enum ReconciliationSeverity {
  CRITICAL
  HIGH
  MEDIUM
  INFO
}

enum ReconciliationResultStatus {
  MISMATCH
  OK
  REVIEWED
  RESOLVED
}

enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum SnapshotRunMode {
  SCHEDULED
  MANUAL
  RERUN
}

enum SnapshotRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum SourceApp {
  WEB
  MOBILE
  API
  INTEGRATION
  SYSTEM
}

// ========== Module 3: Inventory Core Engine Models ==========

model InventDim {
  id                String   @id @default(uuid()) @db.Uuid
  dimId             String   @unique @map("dim_id") @db.VarChar(40)
  dimHash           String   @unique @map("dim_hash") @db.VarChar(64)
  siteId            String   @map("site_id") @db.VarChar(50)
  warehouseId       String   @map("warehouse_id") @db.Uuid
  locationId        String   @map("location_id") @db.Uuid
  ownerId           String   @map("owner_id") @db.Uuid
  inventoryStatusId String   @map("inventory_status_id") @db.Uuid
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  createdBy         String?  @map("created_by") @db.Uuid

  warehouse       MdWarehouse       @relation(fields: [warehouseId], references: [id])
  location        MdLocation        @relation(fields: [locationId], references: [id])
  owner           MdOwner           @relation(fields: [ownerId], references: [id])
  inventoryStatus MdInventoryStatus @relation(fields: [inventoryStatusId], references: [id])

  transFrom       InventTrans[]     @relation("TransDimFrom")
  transTo         InventTrans[]     @relation("TransDimTo")
  onHandRecords   OnHand[]
  holds           InventoryHold[]
  reconcileResults InventoryReconciliationResult[]
  snapshots       DailyStorageSnapshot[]

  @@index([warehouseId, locationId, ownerId, inventoryStatusId])
  @@map("invent_dim")
}

model InventTrans {
  id                 String             @id @default(uuid()) @db.Uuid
  transId            String             @unique @map("trans_id") @db.VarChar(40)
  refType            String             @map("ref_type") @db.VarChar(40)
  refId              String             @map("ref_id") @db.VarChar(50)
  refLineId          String?            @map("ref_line_id") @db.VarChar(50)
  transType          InventoryTransType @map("trans_type")
  itemId             String             @map("item_id") @db.Uuid
  qty                Decimal            @db.Decimal(18, 3)
  uomId              String             @map("uom_id") @db.Uuid
  dimFromId          String?            @map("dim_from_id") @db.Uuid
  dimToId            String?            @map("dim_to_id") @db.Uuid
  statusFromCode     String?            @map("status_from_code") @db.VarChar(30)
  statusToCode       String?            @map("status_to_code") @db.VarChar(30)
  stage              InventoryStage     @default(PHYSICAL)
  externalId         String             @map("external_id") @db.VarChar(120)
  correlationId      String             @map("correlation_id") @db.VarChar(120)
  reasonCode         String?            @map("reason_code") @db.VarChar(50)
  sourceApp          SourceApp          @map("source_app")
  postedBy           String?            @map("posted_by") @db.Uuid
  postedAt           DateTime           @map("posted_at")
  ownerId            String             @map("owner_id") @db.Uuid
  weighbridgeTicketId String?           @map("weighbridge_ticket_id") @db.VarChar(50)
  isReversal         Boolean            @default(false) @map("is_reversal")
  reversalOfTransId  String?            @map("reversal_of_trans_id") @db.VarChar(40)
  createdAt          DateTime           @default(now()) @map("created_at")

  item     MdItem     @relation(fields: [itemId], references: [id])
  uom      MdUom      @relation(fields: [uomId], references: [id])
  dimFrom  InventDim? @relation("TransDimFrom", fields: [dimFromId], references: [id])
  dimTo    InventDim? @relation("TransDimTo", fields: [dimToId], references: [id])
  owner    MdOwner    @relation(fields: [ownerId], references: [id])

  reversalLinksOriginal InventoryReversalLink[] @relation("OriginalTrans")
  reversalLinksReversal InventoryReversalLink[] @relation("ReversalTrans")

  @@unique([externalId, transType])
  @@index([refType, refId, refLineId])
  @@index([itemId, postedAt(sort: Desc)])
  @@index([ownerId, postedAt(sort: Desc)])
  @@index([dimToId, postedAt(sort: Desc)])
  @@index([dimFromId, postedAt(sort: Desc)])
  @@index([correlationId])
  @@map("invent_trans")
}

model OnHand {
  id             String    @id @default(uuid()) @db.Uuid
  itemId         String    @map("item_id") @db.Uuid
  inventDimId    String    @map("invent_dim_id") @db.Uuid
