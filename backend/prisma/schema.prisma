  createdBy          String             @map("created_by") @db.Uuid
  updatedAt          DateTime           @updatedAt @map("updated_at")
  updatedBy          String?            @map("updated_by") @db.Uuid

  plan  IcCycleCountPlan?  @relation(fields: [cycleCountPlanId], references: [id])
  lines IcCycleCountLine[]

  @@index([warehouseId, status, createdAt(sort: Desc)])
  @@index([cycleCountPlanId])
  @@map("ic_cycle_count_header")
}

model IcCycleCountLine {
