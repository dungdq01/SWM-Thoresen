  billingUom              MdUom     @relation("ItemBillingUom", fields: [billingUomId], references: [id])
  catchWeightUom          MdUom?    @relation("ItemCatchWeightUom", fields: [catchWeightUomId], references: [id])
  defaultZone             MdZone?   @relation(fields: [defaultZoneId], references: [id])
  packagingMaterialItem   MdItem?   @relation("PackagingMaterial", fields: [packagingMaterialItemId], references: [id])
  packagingItems          MdItem[]  @relation("PackagingMaterial")
