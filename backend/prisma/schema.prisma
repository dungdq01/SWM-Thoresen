  location      MdLocation        @relation(fields: [locationId], references: [id])
  owner         MdOwner           @relation(fields: [ownerId], references: [id])
  item          MdItem            @relation(fields: [itemId], references: [id])
  debitNoteLine BilDebitNoteLine? @relation(fields: [debitNoteLineId], references: [id])

