  baggedOutputItem  MdItem            @relation("VasBaggedOutput", fields: [baggedOutputItemId], references: [id])
  packagingItem     MdItem            @relation("VasPackaging", fields: [packagingItemId], references: [id])
  packagingOwner    MdOwner           @relation("VasPackagingOwner", fields: [packagingOwnerId], references: [id])
  sessions          VasSession[]
  stateHistory      VasStateHistory[]
  exceptionLogs     VasExceptionLog[]
  outboxEvents      VasOutbox[]

  @@index([warehouseId, status, createdAt(sort: Desc)])
  @@index([ownerId, status, createdAt(sort: Desc)])
  @@index([bulkSourceItemId, status])
  @@index([baggedOutputItemId, status])
  @@index([correlationId])
  @@map("vas_work_order")
