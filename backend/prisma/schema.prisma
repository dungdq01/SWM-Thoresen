// ========== Module 7: Work Execution & Mobile Operations ==========

enum WeWorkType {
  PUTAWAY
  PICK
  MOVE
  TRANSFER_PICK
  TRANSFER_PUT
}

enum WeWorkStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WeWorkLineStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

enum WeStepType {
  PUT
  PICK
  MOVE
  TRANSFER_PICK
  TRANSFER_PUT
}

enum WePostingStatus {
  PENDING
  POSTED
  FAILED
}

enum WeAssignmentMode {
  SELF_CLAIM
  DIRECTED
}

enum WeAssignmentAction {
  CLAIM
  RELEASE
  REASSIGN
}

enum WeStatusObjectType {
  HEADER
  LINE
}

enum WeTriggerAction {
  CREATE
  CLAIM
  RELEASE
  START
  COMPLETE
  SKIP
  CANCEL
  OVERRIDE
}

enum WeExceptionType {
  SHORT_PICK
  LOCATION_MISMATCH
  ITEM_NOT_FOUND
  SYNC_CONFLICT
  POSTING_FAILED
}

enum WeExceptionSeverity {
  INFO
  WARN
  BLOCKER
}

enum WeExceptionStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum WeSyncEventType {
  START_LINE
  COMPLETE_LINE
  SKIP_LINE
}

enum WeSyncResult {
  PENDING
  SUCCESS
  DUPLICATE
  CONFLICT
  REJECTED
}

enum WeSyncBatchStatus {
  RECEIVED
  PROCESSING
  PARTIAL
  SUCCESS
  FAILED
}

enum WeOutboxStatus {
  PENDING
  SENT
  FAILED
  DEAD
}

enum WeSourceModule {
  M4
  M5
  M6
  MANUAL
}

enum WeSourceType {
  RECEIPT
  SHIPMENT
  MOVE_ORDER
  TRANSFER_ORDER
}

model WeWorkHeader {
  id               String           @id @default(uuid()) @db.Uuid
  workId           String           @unique @map("work_id") @db.VarChar(40)
  workType         WeWorkType       @map("work_type")
  status           WeWorkStatus     @default(OPEN)
  priorityNo       Int              @default(50) @map("priority_no")
  warehouseId      String           @map("warehouse_id") @db.Uuid
  zoneId           String?          @map("zone_id") @db.Uuid
  sourceModule     WeSourceModule   @map("source_module")
  sourceType       WeSourceType     @map("source_type")
  sourceRefId      String           @map("source_ref_id") @db.VarChar(50)
  sourceRefLineId  String?          @map("source_ref_line_id") @db.VarChar(50)
  sourceOwnerId    String?          @map("source_owner_id") @db.Uuid
  assignedTo       String?          @map("assigned_to") @db.Uuid
  assignedAt       DateTime?        @map("assigned_at")
  startedAt        DateTime?        @map("started_at")
  completedAt      DateTime?        @map("completed_at")
  cancelledAt      DateTime?        @map("cancelled_at")
  cancelReasonCode String?          @map("cancel_reason_code") @db.VarChar(50)
  assignmentMode   WeAssignmentMode @default(SELF_CLAIM) @map("assignment_mode")
  sourceDocVersion BigInt?          @map("source_doc_version")
  externalId       String           @unique @map("external_id") @db.VarChar(120)
  correlationId    String           @map("correlation_id") @db.Uuid
  sourceApp        SourceApp        @map("source_app")
  versionNo        BigInt           @default(0) @map("version_no")
  createdBy        String?          @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedBy        String?          @map("updated_by") @db.Uuid
  updatedAt        DateTime         @updatedAt @map("updated_at")

  lines              WeWorkLine[]
  assignmentHistory  WeWorkAssignmentHistory[]
  statusHistory      WeWorkStatusHistory[]
  eventLogs          WeWorkEventLog[]
  exceptions         WeWorkException[]
  outboxEvents       WeWorkOutboxEvent[]

  @@unique([sourceModule, sourceType, sourceRefId, sourceRefLineId, workType], name: "we_work_source_unique")
  @@index([status, warehouseId, workType, priorityNo, createdAt(sort: Desc)])
  @@index([assignedTo, status, warehouseId])
  @@index([sourceModule, sourceRefId, workType])
  @@map("we_work_header")
}

model WeWorkLine {
  id                  String           @id @default(uuid()) @db.Uuid
  workHeaderId        String           @map("work_header_id") @db.Uuid
  lineNum             Int              @map("line_num")
  stepType            WeStepType       @map("step_type")
