  uom    MdUom          @relation(fields: [uomId], references: [id])

  allocationRecords ShipmentAllocationRecord[]
  weighingAttempts  ShipmentWeighingAttempt[]
  approvalDecisions ShipmentApprovalDecision[]
  pickWorkLinks     ShipmentPickWorkLink[]
  postingLinks      ShipmentPostingLink[]

  @@unique([shipmentHeaderId, lineNumber])
  @@index([itemId, cargoForm])
  @@index([shipmentHeaderId, lineStatus])
  @@index([soLineId])
  @@map("shipment_line")
}

model ShipmentAllocationRecord {
  id               String           @id @default(uuid()) @db.Uuid
  shipmentHeaderId String           @map("shipment_header_id") @db.Uuid
  shipmentLineId   String           @map("shipment_line_id") @db.Uuid
  locationId       String           @map("location_id") @db.Uuid
  inventDimId      String           @map("invent_dim_id") @db.Uuid
  itemId           String           @map("item_id") @db.Uuid
  ownerId          String           @map("owner_id") @db.Uuid
  allocatedQty     Decimal          @map("allocated_qty") @db.Decimal(18, 3)
  pickedQty        Decimal          @default(0) @map("picked_qty") @db.Decimal(18, 3)
  releasedQty      Decimal          @default(0) @map("released_qty") @db.Decimal(18, 3)
  postedQty        Decimal          @default(0) @map("posted_qty") @db.Decimal(18, 3)
  lotDate          DateTime         @map("lot_date") @db.Date
  fifoRank         Int?             @map("fifo_rank")
  status           AllocationStatus @default(ALLOCATED)
  holdRef          String?          @map("hold_ref") @db.VarChar(50)
  externalId       String?          @map("external_id") @db.VarChar(120)
  correlationId    String           @map("correlation_id") @db.VarChar(120)
  createdAt        DateTime         @default(now()) @map("created_at")
  createdBy        String?          @map("created_by") @db.Uuid
  updatedAt        DateTime         @updatedAt @map("updated_at")
  updatedBy        String?          @map("updated_by") @db.Uuid

  header    ShipmentHeader @relation(fields: [shipmentHeaderId], references: [id])
  line      ShipmentLine   @relation(fields: [shipmentLineId], references: [id])
  location  MdLocation     @relation(fields: [locationId], references: [id])
  inventDim InventDim      @relation(fields: [inventDimId], references: [id])
  item      MdItem         @relation(fields: [itemId], references: [id])
  owner     MdOwner        @relation(fields: [ownerId], references: [id])

  @@index([shipmentLineId, status])
  @@index([shipmentHeaderId, status])
  @@index([inventDimId, status])
  @@index([itemId, ownerId, lotDate, status])
  @@index([holdRef])
  @@map("shipment_allocation_record")
}

model ShipmentWeighingAttempt {
