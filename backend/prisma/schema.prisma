// ========== Module 6: Inventory Control Models ==========

model IcMoveOrder {
  id            String            @id @default(uuid()) @db.Uuid
  moveNumber    String            @unique @map("move_number") @db.VarChar(50)
  warehouseId   String            @map("warehouse_id") @db.Uuid
  executionMode IcExecutionMode   @map("execution_mode")
  status        IcMoveOrderStatus @default(DRAFT)
  reasonCode    String?           @map("reason_code") @db.VarChar(50)
  remarks       String?           @db.Text
  requestedBy   String            @map("requested_by") @db.Uuid
  confirmedBy   String?           @map("confirmed_by") @db.Uuid
  confirmedAt   DateTime?         @map("confirmed_at")
  completedBy   String?           @map("completed_by") @db.Uuid
  completedAt   DateTime?         @map("completed_at")
  workHeaderId  String?           @map("work_header_id") @db.VarChar(50)
  postingStatus IcPostingStatus   @default(PENDING) @map("posting_status")
  postedRef     String?           @map("posted_ref") @db.VarChar(100)
  externalId    String            @unique @map("external_id") @db.VarChar(100)
  correlationId String            @map("correlation_id") @db.VarChar(50)
  sourceApp     SourceApp         @map("source_app")
  rowVersion    BigInt            @default(0) @map("row_version")
  createdAt     DateTime          @default(now()) @map("created_at")
  createdBy     String            @map("created_by") @db.Uuid
  updatedAt     DateTime          @updatedAt @map("updated_at")
  updatedBy     String?           @map("updated_by") @db.Uuid

  lines IcMoveOrderLine[]

  @@index([warehouseId, status, createdAt(sort: Desc)])
  @@index([correlationId])
  @@map("ic_move_order")
}

model IcMoveOrderLine {
  id                 String           @id @default(uuid()) @db.Uuid
  moveOrderId        String           @map("move_order_id") @db.Uuid
  lineNo             Int              @map("line_no")
  itemId             String           @map("item_id") @db.Uuid
  ownerId            String           @map("owner_id") @db.Uuid
  fromLocationId     String           @map("from_location_id") @db.Uuid
  toLocationId       String           @map("to_location_id") @db.Uuid
  inventoryStatus    String           @map("inventory_status") @db.VarChar(30)
  requestedQty       Decimal          @map("requested_qty") @db.Decimal(18, 3)
  executedQty        Decimal?         @map("executed_qty") @db.Decimal(18, 3)
  uom                String           @db.VarChar(20)
  lineStatus         IcMoveLineStatus @default(OPEN) @map("line_status")
  shortageReasonCode String?          @map("shortage_reason_code") @db.VarChar(50)
  postedTransGroupId String?          @map("posted_trans_group_id") @db.VarChar(100)
  rowVersion         BigInt           @default(0) @map("row_version")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  moveOrder IcMoveOrder @relation(fields: [moveOrderId], references: [id])

  @@unique([moveOrderId, lineNo])
  @@index([itemId, ownerId, fromLocationId])
  @@index([toLocationId])
  @@index([lineStatus])
  @@map("ic_move_order_line")
}

model IcTransferOrder {
  id                   String                @id @default(uuid()) @db.Uuid
  transferNumber       String                @unique @map("transfer_number") @db.VarChar(50)
  fromWarehouseId      String                @map("from_warehouse_id") @db.Uuid
  toWarehouseId        String                @map("to_warehouse_id") @db.Uuid
  executionMode        IcExecutionMode       @map("execution_mode")
  status               IcTransferOrderStatus @default(CREATED)
  requestedShipDate    DateTime?             @map("requested_ship_date") @db.Date
  actualShipAt         DateTime?             @map("actual_ship_at")
  actualReceiveAt      DateTime?             @map("actual_receive_at")
  inTransitSlaHours    Int?                  @map("in_transit_sla_hours")
  vehicleNumber        String?               @map("vehicle_number") @db.VarChar(50)
  shippedBy            String?               @map("shipped_by") @db.Uuid
  receivedBy           String?               @map("received_by") @db.Uuid
  cancelReasonCode     String?               @map("cancel_reason_code") @db.VarChar(50)
  closeReasonCode      String?               @map("close_reason_code") @db.VarChar(50)
  postingShipStatus    IcPostingStatus       @default(PENDING) @map("posting_ship_status")
  postingReceiveStatus IcPostingStatus       @default(PENDING) @map("posting_receive_status")
  externalId           String                @unique @map("external_id") @db.VarChar(100)
  correlationId        String                @map("correlation_id") @db.VarChar(50)
