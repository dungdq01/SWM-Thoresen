model RptReconciliationResult {
  id                 String                        @id @default(uuid()) @db.Uuid
  resultId           String                        @unique @map("result_id") @db.VarChar(36)
  runId              String                        @map("run_id") @db.Uuid
  checkId            String                        @map("check_id") @db.Uuid
  checkCode          String                        @map("check_code") @db.VarChar(30)
  checkName          String                        @map("check_name") @db.VarChar(100)
  resultStatus       RptReconciliationResultStatus @map("result_status")
  severity           RptReconciliationSeverity
  dimensionKey       Json?                         @map("dimension_key")
  sourceModule       String                        @map("source_module") @db.VarChar(20)
  sourceRefType      String?                       @map("source_ref_type") @db.VarChar(30)
  sourceRefId        String?                       @map("source_ref_id") @db.VarChar(50)
  expectedValue      Decimal?                      @map("expected_value") @db.Decimal(20, 3)
  actualValue        Decimal?                      @map("actual_value") @db.Decimal(20, 3)
  varianceValue      Decimal?                      @map("variance_value") @db.Decimal(20, 3)
  mismatchDetail     Json?                         @map("mismatch_detail")
  isResolved         Boolean                       @default(false) @map("is_resolved")
  resolvedAt         DateTime?                     @map("resolved_at")
  resolvedBy         String?                       @map("resolved_by") @db.Uuid
  resolutionNote     String?                       @map("resolution_note") @db.Text
  evidenceRef        String?                       @map("evidence_ref") @db.Text
  supersedesResultId String?                       @map("supersedes_result_id") @db.Uuid
  createdAt          DateTime                      @default(now()) @map("created_at")

  run         RptReconciliationRun          @relation(fields: [runId], references: [id])
  check       RptReconciliationCheck        @relation(fields: [checkId], references: [id])
  resolutions RptReconciliationResolution[]

  @@index([checkCode, createdAt(sort: Desc)])
  @@index([resultStatus, severity, createdAt(sort: Desc)])
  @@index([isResolved, severity, createdAt(sort: Desc)])
  @@index([sourceModule, sourceRefId])
  @@map("rpt_reconciliation_result")
}

model RptReconciliationResolution {
  id                     String                             @id @default(uuid()) @db.Uuid
  reconciliationResultId String                             @map("reconciliation_result_id") @db.Uuid
  actionType             RptReconciliationResolutionAction  @map("action_type")
  resolutionNote         String                             @map("resolution_note") @db.Text
  evidenceRef            String?                            @map("evidence_ref") @db.Text
  sourceModule           String?                            @map("source_module") @db.VarChar(20)
  sourceRefId            String?                            @map("source_ref_id") @db.VarChar(50)
  createdBy              String                             @map("created_by") @db.Uuid
  createdAt              DateTime                           @default(now()) @map("created_at")

  result RptReconciliationResult @relation(fields: [reconciliationResultId], references: [id])

