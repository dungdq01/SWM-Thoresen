model VasStateHistory {
  id            String         @id @default(uuid()) @db.Uuid
  woId          String         @map("wo_id") @db.Uuid
  fromStatus    VasWoStatus?   @map("from_status")
  toStatus      VasWoStatus    @map("to_status")
