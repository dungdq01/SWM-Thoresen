generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolePermissionEffect {
  ALLOW
  DENY
}

enum SequenceScopeType {
  GLOBAL
  PER_WAREHOUSE
  CUSTOM
}

enum SequenceResetPolicy {
  NONE
  DAILY
  MONTHLY
  YEARLY
}

enum BusinessRuleStatus {
  CONFIRMED
  TO_CONFIRM
  PHASE_2
}

enum EffectivePhase {
  GO_LIVE
  PHASE_2
}

enum DecisionLogStatus {
  DRAFT
  CONFIRMED
  SUPERSEDED
}

enum ChangePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ChangeControlStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  IMPLEMENTED
}

enum ExceptionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IdempotencyStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

// ========== Module 2: Master Data Management Enums ==========

enum OwnerType {
  DIRECT
  CONSIGNED
  OTHER
}

enum SupplierGroup {
  DOMESTIC
  OVERSEAS
  VESSEL_AGENT
  TRADER
}

enum CargoForm {
  BULK
  BAGGED_25KG
  BAGGED_40KG
  BAGGED_50KG
  JUMBO
  PACKAGING
  CONTAINER
  DRUM
  PALLET
  OTHER
}

enum WarehouseType {
  COVERED
  OPEN_YARD
  MIXED
}

enum ZoneType {
  RECEIVING
  STORAGE
  STAGING
  SHIPPING
  QC
  DAMAGED
  RETURNS
}

enum LocationType {
  RECEIVING
  STORAGE
  STAGING
  SHIPPING
  QC
  DAMAGED
  RETURNS
  VIRTUAL
}

enum LocationStatus {
  OK
  HOLD
  BLOCKED
}

enum UomClass {
  WEIGHT
  VOLUME
  QUANTITY
  LENGTH
  AREA
}

enum VehicleCategory {
  TRUCK
  TRAILER
  CONTAINER
  BARGE
  VESSEL
  VESSEL_SUPPORT
  OTHER
}

enum ServiceGroup {
  STORAGE
  HANDLING
  VAS
  TRANSPORT
  OTHER
}

enum ImportBatchStatus {
  UPLOADED
  VALIDATING
  VALIDATED
  PARTIALLY_COMMITTED
  COMMITTED
  FAILED
  CANCELLED
}

enum ImportActionType {
  INSERT
  UPDATE
  SKIP
  REJECT
}

enum ImportProcessingStatus {
  PENDING
  VALID
  INVALID
  COMMITTED
  SKIPPED
}

enum ImportErrorLevel {
  WARNING
  ERROR
  CRITICAL
}

model AppUser {
  id          String     @id @default(uuid()) @db.Uuid
  userCode    String     @unique @map("user_code") @db.VarChar(50)
  username    String     @unique @db.VarChar(80)
  fullName    String     @map("full_name") @db.VarChar(150)
  email       String?    @unique @db.VarChar(150)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  userRoles   UserRole[]

  @@map("app_user")
}

model Role {
  id            String           @id @default(uuid()) @db.Uuid
  roleCode      String           @unique @map("role_code") @db.VarChar(50)
  roleName      String           @map("role_name") @db.VarChar(150)
  description   String?          @db.Text
  isSystemRole  Boolean          @default(false) @map("is_system_role")
  isActive      Boolean          @default(true) @map("is_active")
  effectiveFrom DateTime?        @map("effective_from")
  effectiveTo   DateTime?        @map("effective_to")
  createdBy     String?          @map("created_by") @db.Uuid
  updatedBy     String?          @map("updated_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  permissions   RolePermission[]
  userRoles     UserRole[]

  @@map("role")
}

model Permission {
  id             String           @id @default(uuid()) @db.Uuid
  permissionCode String           @unique @map("permission_code") @db.VarChar(120)
  moduleCode     String           @map("module_code") @db.VarChar(50)
  resourceCode   String           @map("resource_code") @db.VarChar(50)
  actionCode     String           @map("action_code") @db.VarChar(50)
  description    String?          @db.Text
  isSensitive    Boolean          @default(false) @map("is_sensitive")
  isActive       Boolean          @default(true) @map("is_active")
  createdBy      String?          @map("created_by") @db.Uuid
  updatedBy      String?          @map("updated_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  roleLinks      RolePermission[]

  @@unique([moduleCode, resourceCode, actionCode])
  @@map("permission")
}

model RolePermission {
  id           String               @id @default(uuid()) @db.Uuid
  roleId       String               @map("role_id") @db.Uuid
  permissionId String               @map("permission_id") @db.Uuid
  effect       RolePermissionEffect @default(ALLOW)
  scopeType    String?              @map("scope_type") @db.VarChar(30)
  scopeValue   String?              @map("scope_value") @db.VarChar(100)
  createdBy    String?              @map("created_by") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at")
  role         Role                 @relation(fields: [roleId], references: [id])
  permission   Permission           @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  roleId        String    @map("role_id") @db.Uuid
  warehouseCode String?   @map("warehouse_code") @db.VarChar(50)
  ownerId       String?   @map("owner_id") @db.VarChar(50)
  isPrimary     Boolean   @default(false) @map("is_primary")
  isActive      Boolean   @default(true) @map("is_active")
  assignedAt    DateTime  @default(now()) @map("assigned_at")
  assignedBy    String?   @map("assigned_by") @db.Uuid
  revokedAt     DateTime? @map("revoked_at")
  revokedBy     String?   @map("revoked_by") @db.Uuid
  user          AppUser   @relation(fields: [userId], references: [id])
  role          Role      @relation(fields: [roleId], references: [id])

  @@index([userId, isActive])
  @@index([roleId, isActive])
  @@map("user_role")
}

model ReasonCode {
  id               String    @id @default(uuid()) @db.Uuid
  code             String    @unique @db.VarChar(50)
  description      String    @db.VarChar(255)
  category         String    @db.VarChar(50)
  domainCode       String    @map("domain_code") @db.VarChar(50)
  requiresApproval Boolean   @default(false) @map("requires_approval")
  affectsBilling   Boolean   @default(false) @map("affects_billing")
  requiresNote     Boolean   @default(false) @map("requires_note")
  sortOrder        Int       @default(0) @map("sort_order")
  isActive         Boolean   @default(true) @map("is_active")
  effectiveFrom    DateTime? @map("effective_from")
  effectiveTo      DateTime? @map("effective_to")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([domainCode, category, isActive])
  @@map("reason_code")
}

model NumberSequence {
  id               String              @id @default(uuid()) @db.Uuid
  sequenceCode     String              @unique @map("sequence_code") @db.VarChar(30)
  description      String?             @db.VarChar(255)
  scopeType        SequenceScopeType   @map("scope_type")
  resetPolicy      SequenceResetPolicy @map("reset_policy")
  prefixTemplate   String              @map("prefix_template") @db.VarChar(100)
  formatTemplate   String              @map("format_template") @db.VarChar(150)
  runningNoLength  Int                 @default(6) @map("running_no_length")
  allowGap         Boolean             @default(true) @map("allow_gap")
  isActive         Boolean             @default(true) @map("is_active")
  createdBy        String?             @map("created_by") @db.Uuid
  updatedBy        String?             @map("updated_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  counters         NumberSequenceCounter[]

  @@map("number_sequence")
}

model NumberSequenceCounter {
  id          String         @id @default(uuid()) @db.Uuid
  sequenceId  String         @map("sequence_id") @db.Uuid
  scopeKey    String         @map("scope_key") @db.VarChar(100)
  counterDate DateTime       @db.Date @map("counter_date")
  lastNumber  BigInt         @default(0) @map("last_number")
  versionNo   BigInt         @default(0) @map("version_no")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  sequence    NumberSequence @relation(fields: [sequenceId], references: [id])

  @@unique([sequenceId, scopeKey, counterDate])
  @@map("number_sequence_counter")
}

model BusinessRuleCatalog {
  id             String             @id @default(uuid()) @db.Uuid
  ruleCode       String             @unique @map("rule_code") @db.VarChar(50)
  domain         String             @db.VarChar(50)
  title          String             @db.VarChar(255)
  description    String             @db.Text
  currentStatus  BusinessRuleStatus @map("current_status")
  sourceOfTruth  String             @map("source_of_truth") @db.VarChar(255)
  brdReference   String?            @map("brd_reference") @db.VarChar(255)
  supersedes     String?            @db.VarChar(255)
  effectivePhase EffectivePhase     @map("effective_phase")
  ownerRole      String?            @map("owner_role") @db.VarChar(50)
  lastReviewedAt DateTime?          @map("last_reviewed_at")
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@index([domain, currentStatus])
  @@map("business_rule_catalog")
}

model DecisionLog {
  id              String            @id @default(uuid()) @db.Uuid
  decisionNo      String            @unique @map("decision_no") @db.VarChar(50)
  title           String            @db.VarChar(255)
  decisionType    String            @map("decision_type") @db.VarChar(50)
  contextDomain   String            @map("context_domain") @db.VarChar(50)
  summary         String            @db.Text
  decidedValue    String            @map("decided_value") @db.Text
  rationale       String?           @db.Text
  status          DecisionLogStatus
  sourceRefs      Json?             @map("source_refs")
  impactedModules Json?             @map("impacted_modules")
  effectiveFrom   DateTime?         @map("effective_from")
  decidedBy       String?           @map("decided_by") @db.Uuid
  decidedAt       DateTime?         @map("decided_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@map("decision_log")
}

model ChangeControlRecord {
  id              String              @id @default(uuid()) @db.Uuid
  changeNo        String              @unique @map("change_no") @db.VarChar(50)
  changeType      String              @map("change_type") @db.VarChar(30)
  title           String              @db.VarChar(255)
  description     String              @db.Text
  requestedBy     String?             @map("requested_by") @db.Uuid
  priority        ChangePriority
  impactSummary   String?             @map("impact_summary") @db.Text
  impactedModules Json?               @map("impacted_modules")
  status          ChangeControlStatus
  targetRelease   String?             @map("target_release") @db.VarChar(30)
  approvedBy      String?             @map("approved_by") @db.Uuid
  approvedAt      DateTime?           @map("approved_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@map("change_control_record")
}

model AuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  entityType   String    @map("entity_type") @db.VarChar(50)
  entityId     String    @map("entity_id") @db.VarChar(100)
  action       String    @db.VarChar(50)
  fieldName    String?   @map("field_name") @db.VarChar(100)
  oldValue     String?   @map("old_value") @db.Text
  newValue     String?   @map("new_value") @db.Text
  userId       String?   @map("user_id") @db.Uuid
  userRole     String?   @map("user_role") @db.VarChar(50)
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  deviceType   String?   @map("device_type") @db.VarChar(20)
  occurredAt   DateTime  @default(now()) @map("occurred_at")
  reasonCode   String?   @map("reason_code") @db.VarChar(50)
  notes        String?   @db.Text
  correlationId String?  @map("correlation_id") @db.VarChar(100)
  requestId    String?   @map("request_id") @db.VarChar(100)
  sourceModule String?   @map("source_module") @db.VarChar(50)
  warehouseCode String?  @map("warehouse_code") @db.VarChar(50)
  ownerId      String?   @map("owner_id") @db.VarChar(50)
  metadata     Json?

  @@index([entityType, entityId, occurredAt])
  @@index([userId, occurredAt])
  @@index([correlationId])
  @@index([sourceModule, occurredAt])
  @@map("audit_log")
}

model ExceptionLog {
  id            String            @id @default(uuid()) @db.Uuid
  exceptionNo   String            @unique @map("exception_no") @db.VarChar(50)
  exceptionType String            @map("exception_type") @db.VarChar(50)
  severity      ExceptionSeverity
  sourceModule  String            @map("source_module") @db.VarChar(50)
  entityType    String?           @map("entity_type") @db.VarChar(50)
  entityId      String?           @map("entity_id") @db.VarChar(100)
  action        String?           @db.VarChar(50)
  reasonCode    String?           @map("reason_code") @db.VarChar(50)
  message       String            @db.Text
  details       Json?
  correlationId String?           @map("correlation_id") @db.VarChar(100)
  externalId    String?           @map("external_id") @db.VarChar(100)
  userId        String?           @map("user_id") @db.Uuid
  userRole      String?           @map("user_role") @db.VarChar(50)
  occurredAt    DateTime          @default(now()) @map("occurred_at")
  isResolved    Boolean           @default(false) @map("is_resolved")
  resolvedAt    DateTime?         @map("resolved_at")
  resolvedBy    String?           @map("resolved_by") @db.Uuid

  @@index([sourceModule, occurredAt])
  @@index([isResolved, occurredAt])
  @@map("exception_log")
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  idempotencyKey String            @unique @map("idempotency_key") @db.VarChar(120)
  commandName    String            @map("command_name") @db.VarChar(100)
  sourceModule   String            @map("source_module") @db.VarChar(50)
  requestHash    String?           @map("request_hash") @db.VarChar(128)
  requestPayload Json?             @map("request_payload")
  responseCode   Int?              @map("response_code")
  responseBody   Json?             @map("response_body")
  resourceType   String?           @map("resource_type") @db.VarChar(50)
  resourceId     String?           @map("resource_id") @db.VarChar(100)
  status         IdempotencyStatus
  lockedUntil    DateTime?         @map("locked_until")
  correlationId  String?           @map("correlation_id") @db.VarChar(100)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  expiredAt      DateTime?         @map("expired_at")

  @@index([commandName, sourceModule])
  @@index([expiredAt])
  @@map("idempotency_record")
}

// ========== Module 2: Master Data Management Models ==========

model MdUom {
  id               String    @id @default(uuid()) @db.Uuid
  uomCode          String    @unique @map("uom_code") @db.VarChar(20)
  description      String    @db.VarChar(255)
  uomClass         UomClass  @map("uom_class")
  isBaseUom        Boolean   @default(false) @map("is_base_uom")
  decimalPrecision Int       @default(2) @map("decimal_precision") @db.SmallInt
  isActive         Boolean   @default(true) @map("is_active")
  rowVersion       BigInt    @default(0) @map("row_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedAt        DateTime  @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by") @db.Uuid
  deactivatedAt    DateTime? @map("deactivated_at")
  deactivatedBy    String?   @map("deactivated_by") @db.Uuid

  itemsBaseUom       MdItem[]          @relation("ItemBaseUom")
  itemsBillingUom    MdItem[]          @relation("ItemBillingUom")
  itemsCatchWeightUom MdItem[]         @relation("ItemCatchWeightUom")
  serviceCodes       MdServiceCode[]
  rateReferences     MdRateReference[]
  ownerItemPolicies  MdOwnerItemPolicy[]
  conversionsFrom    MdUomConversion[] @relation("ConversionFrom")
  conversionsTo      MdUomConversion[] @relation("ConversionTo")
  inventTrans        InventTrans[]
  onHandRecords      OnHand[]
  receiptLines       ReceiptLine[]

  @@map("md_uom")
}

model MdInventoryStatus {
  id             String   @id @default(uuid()) @db.Uuid
  statusCode     String   @unique @map("status_code") @db.VarChar(30)
  description    String   @db.VarChar(255)
  displayOrder   Int      @default(0) @map("display_order") @db.SmallInt
  isAllocatable  Boolean  @default(false) @map("is_allocatable")
  isSystemLocked Boolean  @default(true) @map("is_system_locked")
  isActive       Boolean  @default(true) @map("is_active")
  rowVersion     BigInt   @default(0) @map("row_version")
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedBy      String?  @map("updated_by") @db.Uuid

  inventDims     InventDim[]

  @@map("md_inventory_status")
}

model MdWarehouse {
  id                        String    @id @default(uuid()) @db.Uuid
  warehouseCode             String    @unique @map("warehouse_code") @db.VarChar(50)
  warehouseName             String    @map("warehouse_name") @db.VarChar(255)
  siteId                    String    @default("TVL-SITE") @map("site_id") @db.VarChar(50)
  warehouseType             WarehouseType @map("warehouse_type")
  totalAreaM2               Decimal   @map("total_area_m2") @db.Decimal(18, 2)
  usableAreaM2              Decimal?  @map("usable_area_m2") @db.Decimal(18, 2)
  maxHeightM                Decimal   @map("max_height_m") @db.Decimal(18, 2)
  maxCapacityMt             Decimal   @map("max_capacity_mt") @db.Decimal(18, 3)
  address                   String?   @db.Text
  hasWeighbridge            Boolean   @default(false) @map("has_weighbridge")
  weighbridgeCount          Int?      @map("weighbridge_count")
  isBonded                  Boolean   @default(false) @map("is_bonded")
  capacityWarningPct        Decimal   @map("capacity_warning_pct") @db.Decimal(5, 2)
  defaultReceivingLocationId String?  @map("default_receiving_location_id") @db.Uuid
  defaultStagingLocationId  String?   @map("default_staging_location_id") @db.Uuid
  defaultShippingLocationId String?   @map("default_shipping_location_id") @db.Uuid
  isActive                  Boolean   @default(true) @map("is_active")
  rowVersion                BigInt    @default(0) @map("row_version")
  createdAt                 DateTime  @default(now()) @map("created_at")
  createdBy                 String?   @map("created_by") @db.Uuid
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  updatedBy                 String?   @map("updated_by") @db.Uuid
  deactivatedAt             DateTime? @map("deactivated_at")
  deactivatedBy             String?   @map("deactivated_by") @db.Uuid

  zones                     MdZone[]
  locations                 MdLocation[]
  owners                    MdOwner[]
  rateReferences            MdRateReference[]
  ownerItemPolicies         MdOwnerItemPolicy[]
  inventDims                InventDim[]
  reconciliationRuns        InventoryReconciliationRun[]
  snapshotRuns              InventorySnapshotRun[]
  dailySnapshots            DailyStorageSnapshot[]
  receiptHeaders            ReceiptHeader[]

  @@map("md_warehouse")
}

model MdZone {
  id              String    @id @default(uuid()) @db.Uuid
  warehouseId     String    @map("warehouse_id") @db.Uuid
  zoneCode        String    @map("zone_code") @db.VarChar(50)
  zoneName        String    @map("zone_name") @db.VarChar(255)
  zoneType        ZoneType  @map("zone_type")
  isBillingZone   Boolean   @default(false) @map("is_billing_zone")
  billingRateZone String?   @map("billing_rate_zone") @db.VarChar(100)
  maxCapacityMt   Decimal?  @map("max_capacity_mt") @db.Decimal(18, 3)
  isActive        Boolean   @default(true) @map("is_active")
  rowVersion      BigInt    @default(0) @map("row_version")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by") @db.Uuid
  deactivatedAt   DateTime? @map("deactivated_at")
  deactivatedBy   String?   @map("deactivated_by") @db.Uuid

  warehouse       MdWarehouse @relation(fields: [warehouseId], references: [id])
  locations       MdLocation[]
  items           MdItem[]

  @@unique([warehouseId, zoneCode])
  @@map("md_zone")
}

model MdLocation {
  id                String         @id @default(uuid()) @db.Uuid
  warehouseId       String         @map("warehouse_id") @db.Uuid
  zoneId            String         @map("zone_id") @db.Uuid
  locationCode      String         @map("location_code") @db.VarChar(50)
  locationType      LocationType   @map("location_type")
  locationProfile   String         @map("location_profile") @db.VarChar(50)
  status            LocationStatus @default(OK)
  areaM2            Decimal?       @map("area_m2") @db.Decimal(18, 2)
  maxHeightM        Decimal?       @map("max_height_m") @db.Decimal(18, 2)
  stackLimitKg      Decimal?       @map("stack_limit_kg") @db.Decimal(18, 3)
  isMixedOwner      Boolean        @default(false) @map("is_mixed_owner")
  isMixedProduct    Boolean        @default(false) @map("is_mixed_product")
  isBillingLocation Boolean        @default(false) @map("is_billing_location")
  stackingRule      String?        @map("stacking_rule") @db.VarChar(30)
  xCoord            Decimal?       @map("x_coord") @db.Decimal(18, 6)
  yCoord            Decimal?       @map("y_coord") @db.Decimal(18, 6)
  isActive          Boolean        @default(true) @map("is_active")
  rowVersion        BigInt         @default(0) @map("row_version")
  createdAt         DateTime       @default(now()) @map("created_at")
  createdBy         String?        @map("created_by") @db.Uuid
  updatedAt         DateTime       @updatedAt @map("updated_at")
  updatedBy         String?        @map("updated_by") @db.Uuid
  deactivatedAt     DateTime?      @map("deactivated_at")
  deactivatedBy     String?        @map("deactivated_by") @db.Uuid

  warehouse         MdWarehouse    @relation(fields: [warehouseId], references: [id])
  zone              MdZone         @relation(fields: [zoneId], references: [id])
  inventDims        InventDim[]
  dailySnapshots    DailyStorageSnapshot[]
  receiptHeaders    ReceiptHeader[]

  @@unique([warehouseId, locationCode])
  @@index([zoneId, isActive])
  @@map("md_location")
}

model MdOwner {
  id                   String    @id @default(uuid()) @db.Uuid
  ownerCode            String    @unique @map("owner_code") @db.VarChar(50)
  ownerName            String    @map("owner_name") @db.VarChar(255)
  shortName            String    @map("short_name") @db.VarChar(100)
  ownerGroup           String    @map("owner_group") @db.VarChar(100)
  ownerType            OwnerType @map("owner_type")
  taxCode              String    @map("tax_code") @db.VarChar(50)
  address              String    @db.Text
  billingEmail         String?   @map("billing_email") @db.VarChar(255)
  billingContact       String?   @map("billing_contact") @db.VarChar(255)
  paymentTerms         String?   @map("payment_terms") @db.VarChar(30)
  defaultTolerancePct  Decimal?  @map("default_tolerance_pct") @db.Decimal(8, 4)
  defaultWarehouseId   String?   @map("default_warehouse_id") @db.Uuid
