model BilErpPushLog {
  id                  String   @id @default(uuid()) @db.Uuid
  debitNoteId         String   @map("debit_note_id") @db.Uuid
  outboxId            String   @map("outbox_id") @db.Uuid
  requestPayloadJson  Json     @map("request_payload_json")
