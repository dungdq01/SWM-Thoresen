model VasSession {
  id               String       @id @default(uuid()) @db.Uuid
  woId             String       @map("wo_id") @db.Uuid
  sessionNum       Int          @map("session_num")
  sessionDate      DateTime     @map("session_date") @db.Date
  shiftCode        VasShiftCode @map("shift_code")
