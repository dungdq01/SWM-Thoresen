  remarks       String?        @db.Text
  actorId       String         @map("actor_id") @db.Uuid
  actorRole     String         @map("actor_role") @db.VarChar(30)
  correlationId String         @map("correlation_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")

  workOrder VasWorkOrder @relation(fields: [woId], references: [id])

  @@index([woId, createdAt(sort: Desc)])
  @@index([correlationId])
  @@map("vas_state_history")
}

model VasExceptionLog {
  id            String               @id @default(uuid()) @db.Uuid
  woId          String               @map("wo_id") @db.Uuid
  exceptionCode String               @map("exception_code") @db.VarChar(50)
  severity      VasExceptionSeverity
  payloadJson   Json?                @map("payload_json")
  reasonCode    String?              @map("reason_code") @db.VarChar(50)
  resolvedAt    DateTime?            @map("resolved_at")
  resolvedBy    String?              @map("resolved_by") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at")

  workOrder VasWorkOrder @relation(fields: [woId], references: [id])

  @@index([woId, createdAt(sort: Desc)])
  @@index([exceptionCode, severity])
