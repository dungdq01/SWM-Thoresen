  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  releasedAt     DateTime?  @map("released_at")
  releasedBy     String?    @map("released_by") @db.Uuid

  item      MdItem    @relation(fields: [itemId], references: [id])
  inventDim InventDim @relation(fields: [inventDimId], references: [id])
  onHand    OnHand    @relation(fields: [onHandId], references: [id])

  @@index([shipmentId, shipmentLineId])
  @@index([itemId, inventDimId, status])
  @@index([externalId])
  @@map("inventory_hold")
}

model InventoryReversalLink {
  id                  String   @id @default(uuid()) @db.Uuid
  originalTransId     String   @map("original_trans_id") @db.Uuid
  reversalTransId     String   @map("reversal_trans_id") @db.Uuid
  reverseReasonCode   String   @map("reverse_reason_code") @db.VarChar(50)
  reverseNote         String?  @map("reverse_note") @db.Text
  reversedBy          String?  @map("reversed_by") @db.Uuid
  reversedAt          DateTime @map("reversed_at")
  correctionRefType   String?  @map("correction_ref_type") @db.VarChar(40)
  correctionRefId     String?  @map("correction_ref_id") @db.VarChar(50)
  correlationId       String   @map("correlation_id") @db.VarChar(120)

  originalTrans InventTrans @relation("OriginalTrans", fields: [originalTransId], references: [id])
  reversalTrans InventTrans @relation("ReversalTrans", fields: [reversalTransId], references: [id])

  @@unique([originalTransId, reversalTransId])
  @@map("inventory_reversal_link")
}

model InventoryReconciliationRun {
  id            String                   @id @default(uuid()) @db.Uuid
  runNo         String                   @unique @map("run_no") @db.VarChar(40)
  runType       ReconciliationRunType    @map("run_type")
  scopeType     ReconciliationScopeType  @map("scope_type")
  warehouseId   String?                  @map("warehouse_id") @db.Uuid
  ownerId       String?                  @map("owner_id") @db.Uuid
  itemId        String?                  @map("item_id") @db.Uuid
  startedAt     DateTime                 @map("started_at")
  completedAt   DateTime?                @map("completed_at")
  status        ReconciliationRunStatus
  mismatchCount Int                      @default(0) @map("mismatch_count")
  requestedBy   String?                  @map("requested_by") @db.Uuid
  correlationId String                   @map("correlation_id") @db.VarChar(120)

  warehouse MdWarehouse? @relation(fields: [warehouseId], references: [id])
  owner     MdOwner?     @relation(fields: [ownerId], references: [id])
  item      MdItem?      @relation(fields: [itemId], references: [id])

  results InventoryReconciliationResult[]

  @@index([status, startedAt])
  @@map("inventory_reconciliation_run")
}

model InventoryReconciliationResult {
  id               String                      @id @default(uuid()) @db.Uuid
  runId            String                      @map("run_id") @db.Uuid
  itemId           String                      @map("item_id") @db.Uuid
  inventDimId      String                      @map("invent_dim_id") @db.Uuid
  ledgerQty        Decimal                     @map("ledger_qty") @db.Decimal(18, 3)
  onhandPhysicalQty Decimal                    @map("onhand_physical_qty") @db.Decimal(18, 3)
  reservedQty      Decimal                     @map("reserved_qty") @db.Decimal(18, 3)
  availableQty     Decimal                     @map("available_qty") @db.Decimal(18, 3)
  diffQty          Decimal                     @map("diff_qty") @db.Decimal(18, 3)
  severity         ReconciliationSeverity
  ruleCode         String                      @map("rule_code") @db.VarChar(40)
  resultStatus     ReconciliationResultStatus  @map("result_status")
  createdAt        DateTime                    @default(now()) @map("created_at")

  run       InventoryReconciliationRun @relation(fields: [runId], references: [id])
  item      MdItem                     @relation(fields: [itemId], references: [id])
  inventDim InventDim                  @relation(fields: [inventDimId], references: [id])

  @@index([runId])
  @@index([itemId, inventDimId])
  @@index([severity, resultStatus])
  @@map("inventory_reconciliation_result")
}

model InventorySnapshotRun {
  id            String            @id @default(uuid()) @db.Uuid
  runNo         String            @unique @map("run_no") @db.VarChar(40)
  snapshotDate  DateTime          @map("snapshot_date") @db.Date
  warehouseId   String?           @map("warehouse_id") @db.Uuid
  cutOffTime    DateTime          @map("cut_off_time")
  runMode       SnapshotRunMode   @map("run_mode")
  versionNo     Int               @default(1) @map("version_no")
  status        SnapshotRunStatus
  startedAt     DateTime          @map("started_at")
  completedAt   DateTime?         @map("completed_at")
  requestedBy   String?           @map("requested_by") @db.Uuid
  correlationId String            @map("correlation_id") @db.VarChar(120)

  warehouse MdWarehouse? @relation(fields: [warehouseId], references: [id])

  snapshots DailyStorageSnapshot[]

  @@unique([snapshotDate, warehouseId, versionNo])
  @@map("inventory_snapshot_run")
}

model DailyStorageSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  snapshotRunId   String   @map("snapshot_run_id") @db.Uuid
  snapshotDate    DateTime @map("snapshot_date") @db.Date
  warehouseId     String   @map("warehouse_id") @db.Uuid
  locationId      String   @map("location_id") @db.Uuid
  ownerId         String   @map("owner_id") @db.Uuid
  itemId          String   @map("item_id") @db.Uuid
  inventDimId     String   @map("invent_dim_id") @db.Uuid
  openingQty      Decimal  @map("opening_qty") @db.Decimal(18, 3)
  inboundTodayQty Decimal  @map("inbound_today_qty") @db.Decimal(18, 3)
  outboundTodayQty Decimal @map("outbound_today_qty") @db.Decimal(18, 3)
  closingQty      Decimal  @map("closing_qty") @db.Decimal(18, 3)
  cutOffTime      DateTime @map("cut_off_time")
  snapshotSource  String   @map("snapshot_source") @db.VarChar(50)
  correlationId   String?  @map("correlation_id") @db.VarChar(120)
  createdAt       DateTime @default(now()) @map("created_at")

  snapshotRun InventorySnapshotRun @relation(fields: [snapshotRunId], references: [id])
  warehouse   MdWarehouse          @relation(fields: [warehouseId], references: [id])
  location    MdLocation           @relation(fields: [locationId], references: [id])
  owner       MdOwner              @relation(fields: [ownerId], references: [id])
  item        MdItem               @relation(fields: [itemId], references: [id])
  inventDim   InventDim            @relation(fields: [inventDimId], references: [id])

  @@index([snapshotDate, warehouseId, ownerId])
  @@index([ownerId, itemId, snapshotDate])
  @@map("daily_storage_snapshot")
}

model InventoryEventMapping {
  id            String  @id @default(uuid()) @db.Uuid
  eventCode     String  @unique @map("event_code") @db.VarChar(50)
  sourceModule  String  @map("source_module") @db.VarChar(20)
  sourceObject  String  @map("source_object") @db.VarChar(40)
  triggerState  String  @map("trigger_state") @db.VarChar(40)
  transType     InventoryTransType @map("trans_type")
  affectPhysical Boolean @map("affect_physical")
  affectHold    Boolean @map("affect_hold")
  reversible    Boolean
  activeFlag    Boolean @default(true) @map("active_flag")
  notes         String? @db.Text

  @@map("inventory_event_mapping")
}

// ========== Module 4: Inbound Operations Enums ==========

enum ReceiptType {
  STANDARD
  VESSEL
}

enum ReceiptStatus {
  DRAFT
  AWAITING_WEIGHING
  WEIGHED_IN
  PROCESSING
  WEIGHED_OUT
  RECEIVED
  PUTAWAY
  CLOSED
  REJECTED
  CANCELLED
}

enum ReceiptLineStatus {
  OPEN
  RECEIVED
  CANCELLED
}

enum WeighPhase {
  IN
  OUT
}

enum IntegrationDeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

// ========== Module 4: Inbound Operations Models ==========

model ReceiptHeader {
  id                    String        @id @default(uuid()) @db.Uuid
  receiptNumber         String?       @unique @map("receipt_number") @db.VarChar(40)
  receiptType           ReceiptType   @map("receipt_type")
  poId                  String        @map("po_id") @db.VarChar(50)
  asnId                 String?       @map("asn_id") @db.VarChar(50)
  ownerId               String        @map("owner_id") @db.Uuid
  vendorId              String        @map("vendor_id") @db.Uuid
  warehouseId           String        @map("warehouse_id") @db.Uuid
  receivingLocationId   String        @map("receiving_location_id") @db.Uuid
  vehicleNumber         String        @map("vehicle_number") @db.VarChar(30)
  blNumber              String?       @map("bl_number") @db.VarChar(50)
  expectedQty           Decimal       @map("expected_qty") @db.Decimal(18, 3)
  grossWeightKg         Decimal?      @map("gross_weight_kg") @db.Decimal(18, 3)
  tareWeightKg          Decimal?      @map("tare_weight_kg") @db.Decimal(18, 3)
  netWeightKg           Decimal?      @map("net_weight_kg") @db.Decimal(18, 3)
  status                ReceiptStatus @default(DRAFT)
  attemptNumber         Int           @default(1) @map("attempt_number")
  tolerancePctApplied   Decimal?      @map("tolerance_pct_applied") @db.Decimal(8, 4)
  variancePct           Decimal?      @map("variance_pct") @db.Decimal(8, 4)
  isManualEntry         Boolean       @default(false) @map("is_manual_entry")
  manualEntryReasonCode String?       @map("manual_entry_reason_code") @db.VarChar(50)
  postedTransId         String?       @map("posted_trans_id") @db.VarChar(40)
  putawayWorkId         String?       @map("putaway_work_id") @db.VarChar(50)
  cancelReasonCode      String?       @map("cancel_reason_code") @db.VarChar(50)
  cancelledBy           String?       @map("cancelled_by") @db.Uuid
  cancelledAt           DateTime?     @map("cancelled_at")
  externalId            String        @unique @map("external_id") @db.VarChar(120)
  correlationId         String        @map("correlation_id") @db.VarChar(120)
  sourceApp             SourceApp     @map("source_app")
  rowVersion            BigInt        @default(0) @map("row_version")
  createdAt             DateTime      @default(now()) @map("created_at")
  createdBy             String?       @map("created_by") @db.Uuid
  updatedAt             DateTime      @updatedAt @map("updated_at")
  updatedBy             String?       @map("updated_by") @db.Uuid

  owner              MdOwner      @relation(fields: [ownerId], references: [id])
  vendor             MdVendor     @relation(fields: [vendorId], references: [id])
  warehouse          MdWarehouse  @relation(fields: [warehouseId], references: [id])
  receivingLocation  MdLocation   @relation(fields: [receivingLocationId], references: [id])

  lines              ReceiptLine[]
  weighingLogs       ReceiptWeighingLog[]
  statusHistory      ReceiptStatusHistory[]
  exceptionLogs      ReceiptExceptionLog[]
  integrationStates  ReceiptIntegrationState[]

  @@index([vehicleNumber, status, createdAt(sort: Desc)])
  @@index([blNumber, status, createdAt(sort: Desc)])
  @@index([ownerId, warehouseId, status, createdAt(sort: Desc)])
  @@index([poId, asnId])
  @@index([status, createdAt(sort: Desc)])
  @@index([correlationId])
  @@map("receipt_header")
}

model ReceiptLine {
  id                   String            @id @default(uuid()) @db.Uuid
  receiptHeaderId      String            @map("receipt_header_id") @db.Uuid
  lineNumber           Int               @map("line_number")
  itemId               String            @map("item_id") @db.Uuid
  uomId                String            @map("uom_id") @db.Uuid
  expectedQty          Decimal           @map("expected_qty") @db.Decimal(18, 3)
  receivedQty          Decimal?          @map("received_qty") @db.Decimal(18, 3)
  bagCount             Int?              @map("bag_count")
  nominalWeightPerBag  Decimal?          @map("nominal_weight_per_bag") @db.Decimal(18, 3)
  cargoForm            CargoForm         @map("cargo_form")
  status               ReceiptLineStatus @default(OPEN)
  createdAt            DateTime          @default(now()) @map("created_at")
  createdBy            String?           @map("created_by") @db.Uuid
  updatedAt            DateTime          @updatedAt @map("updated_at")
  updatedBy            String?           @map("updated_by") @db.Uuid

  header        ReceiptHeader @relation(fields: [receiptHeaderId], references: [id])
  item          MdItem        @relation(fields: [itemId], references: [id])
  uom           MdUom         @relation(fields: [uomId], references: [id])

  @@unique([receiptHeaderId, lineNumber])
  @@index([itemId, cargoForm])
  @@index([receiptHeaderId, status])
  @@map("receipt_line")
}

model ReceiptWeighingLog {
  id               String     @id @default(uuid()) @db.Uuid
  receiptHeaderId  String     @map("receipt_header_id") @db.Uuid
  attemptNumber    Int        @map("attempt_number")
  weighPhase       WeighPhase @map("weigh_phase")
  ticketId         String?    @map("ticket_id") @db.VarChar(80)
  eventId          String?    @map("event_id") @db.VarChar(120)
  grossWeightKg    Decimal?   @map("gross_weight_kg") @db.Decimal(18, 3)
  tareWeightKg     Decimal?   @map("tare_weight_kg") @db.Decimal(18, 3)
  netWeightKg      Decimal?   @map("net_weight_kg") @db.Decimal(18, 3)
  isManual         Boolean    @default(false) @map("is_manual")
  manualReasonCode String?    @map("manual_reason_code") @db.VarChar(50)
  sourceApp        SourceApp  @map("source_app")
  eventTimestamp   DateTime   @map("event_timestamp")
  receivedAt       DateTime   @default(now()) @map("received_at")
  rawPayload       Json?      @map("raw_payload")
  createdBy        String?    @map("created_by") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at")

  receiptHeader ReceiptHeader @relation(fields: [receiptHeaderId], references: [id])

  @@unique([eventId])
  @@index([receiptHeaderId, attemptNumber, weighPhase])
  @@index([ticketId, weighPhase])
  @@index([eventTimestamp(sort: Desc)])
  @@map("receipt_weighing_log")
}

model ReceiptStatusHistory {
  id               String    @id @default(uuid()) @db.Uuid
  receiptHeaderId  String    @map("receipt_header_id") @db.Uuid
  fromStatus       String?   @map("from_status") @db.VarChar(30)
  toStatus         String    @map("to_status") @db.VarChar(30)
  transitionCode   String    @map("transition_code") @db.VarChar(30)
  triggeredBy      String?   @map("triggered_by") @db.Uuid
  triggerRole      String?   @map("trigger_role") @db.VarChar(50)
  reasonCode       String?   @map("reason_code") @db.VarChar(50)
  note             String?   @db.Text
  correlationId    String    @map("correlation_id") @db.VarChar(120)
  occurredAt       DateTime  @default(now()) @map("occurred_at")
  metadata         Json?

  receiptHeader ReceiptHeader @relation(fields: [receiptHeaderId], references: [id])

  @@index([receiptHeaderId, occurredAt(sort: Desc)])
  @@index([toStatus, occurredAt(sort: Desc)])
  @@map("receipt_status_history")
}

model ReceiptExceptionLog {
  id                String            @id @default(uuid()) @db.Uuid
  receiptHeaderId   String?           @map("receipt_header_id") @db.Uuid
  exceptionType     String            @map("exception_type") @db.VarChar(50)
  severity          ExceptionSeverity
  stage             String            @db.VarChar(30)
  reasonCode        String?           @map("reason_code") @db.VarChar(50)
  message           String            @db.Text
  details           Json?
  integrationTarget String?           @map("integration_target") @db.VarChar(30)
  externalId        String?           @map("external_id") @db.VarChar(120)
  correlationId     String            @map("correlation_id") @db.VarChar(120)
  occurredBy        String?           @map("occurred_by") @db.Uuid
  occurredAt        DateTime          @default(now()) @map("occurred_at")
  isResolved        Boolean           @default(false) @map("is_resolved")
  resolvedAt        DateTime?         @map("resolved_at")
  resolvedBy        String?           @map("resolved_by") @db.Uuid

  receiptHeader ReceiptHeader? @relation(fields: [receiptHeaderId], references: [id])

  @@index([receiptHeaderId, occurredAt(sort: Desc)])
  @@index([exceptionType, severity, occurredAt(sort: Desc)])
  @@index([integrationTarget, isResolved])
  @@map("receipt_exception_log")
}

model ReceiptIntegrationState {
  id                  String                    @id @default(uuid()) @db.Uuid
  receiptHeaderId     String                    @map("receipt_header_id") @db.Uuid
  targetModule        String                    @map("target_module") @db.VarChar(20)
  actionCode          String                    @map("action_code") @db.VarChar(40)
  deliveryStatus      IntegrationDeliveryStatus @map("delivery_status")
  attemptCount        Int                       @default(0) @map("attempt_count")
  lastRequestPayload  Json?                     @map("last_request_payload")
  lastResponsePayload Json?                     @map("last_response_payload")
  lastErrorCode       String?                   @map("last_error_code") @db.VarChar(50)
  lastErrorMessage    String?                   @map("last_error_message") @db.Text
  nextRetryAt         DateTime?                 @map("next_retry_at")
  lastAttemptAt       DateTime?                 @map("last_attempt_at")
  completedAt         DateTime?                 @map("completed_at")
  correlationId       String                    @map("correlation_id") @db.VarChar(120)
  externalId          String                    @map("external_id") @db.VarChar(120)
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  receiptHeader ReceiptHeader @relation(fields: [receiptHeaderId], references: [id])

  @@unique([receiptHeaderId, targetModule, actionCode])
  @@index([deliveryStatus, nextRetryAt])
  @@map("receipt_integration_state")
}


