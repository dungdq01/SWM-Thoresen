model IcMoveOrder {
  id            String            @id @default(uuid()) @db.Uuid
  moveNumber    String            @unique @map("move_number") @db.VarChar(50)
  warehouseId   String            @map("warehouse_id") @db.Uuid
  executionMode IcExecutionMode   @map("execution_mode")
  status        IcMoveOrderStatus @default(DRAFT)
  reasonCode    String?           @map("reason_code") @db.VarChar(50)
  remarks       String?           @db.Text
  requestedBy   String            @map("requested_by") @db.Uuid
  confirmedBy   String?           @map("confirmed_by") @db.Uuid
  confirmedAt   DateTime?         @map("confirmed_at")
  completedBy   String?           @map("completed_by") @db.Uuid
  completedAt   DateTime?         @map("completed_at")
  workHeaderId  String?           @map("work_header_id") @db.VarChar(50)
  postingStatus IcPostingStatus   @default(PENDING) @map("posting_status")
  postedRef     String?           @map("posted_ref") @db.VarChar(100)
  externalId    String            @unique @map("external_id") @db.VarChar(100)
  correlationId String            @map("correlation_id") @db.VarChar(50)
  sourceApp     SourceApp         @map("source_app")
  rowVersion    BigInt            @default(0) @map("row_version")
  createdAt     DateTime          @default(now()) @map("created_at")
  createdBy     String            @map("created_by") @db.Uuid
  updatedAt     DateTime          @updatedAt @map("updated_at")
  updatedBy     String?           @map("updated_by") @db.Uuid

  lines IcMoveOrderLine[]

  @@index([warehouseId, status, createdAt(sort: Desc)])
  @@index([correlationId])
  @@map("ic_move_order")
}

model IcMoveOrderLine {
  id                 String           @id @default(uuid()) @db.Uuid
  moveOrderId        String           @map("move_order_id") @db.Uuid
