}

model VasOutbox {
  id              String          @id @default(uuid()) @db.Uuid
  eventType       String          @map("event_type") @db.VarChar(50)
  aggregateType   String          @default("VAS_WORK_ORDER") @map("aggregate_type") @db.VarChar(50)
  aggregateId     String          @map("aggregate_id") @db.Uuid
  aggregateNumber String          @map("aggregate_number") @db.VarChar(30)
  eventKey        String          @unique @map("event_key") @db.VarChar(120)
  payloadJson     Json            @map("payload_json")
  status          VasOutboxStatus @default(PENDING)
