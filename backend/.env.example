PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/swms?schema=public"
JWT_SECRET="dev-secret"
DEV_AUTH_BYPASS=true

# Google Cloud Vision API
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
