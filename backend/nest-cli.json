{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "modules/inventory-core/**/*.js",
        "outDir": "dist/src"
      },
      {
        "include": "modules/inbound/**/*.js",
        "outDir": "dist/src"
      }
    ],
    "watchAssets": true
  }
}
